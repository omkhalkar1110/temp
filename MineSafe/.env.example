# Google Maps Platform API Key
# Required for GoogleFleetMap interactive mining map integration
# Google Cloud Console APIs to enable:
# 1. Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend REST API & Socket.IO (local development defaults)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# NOTE: Supabase credentials go in backend/.env ONLY.
# This is a Vite SPA — the frontend never calls Supabase directly.
# Do NOT add NEXT_PUBLIC_SUPABASE_* or VITE_SUPABASE_* keys here.
# Do NOT install @supabase/ssr — it is a Next.js-only package.

# Demo / Auth mode (true = no real Firebase token required, email bypass active)
VITE_DEMO_MODE=true

# Firebase Configuration (optional — dev email/password bypass works without these)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
