NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Operational Mode
OPERATION_MODE=SIMULATION
SIMULATION_ENABLED=true
HARDWARE_ENABLED=false

# Single Cloud Database (Supabase PostgreSQL)
SUPABASE_URL=https://ecchkcsubizuwbvostyl.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVjY2hrY3N1Yml6dXdidm9zdHlsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk5NzYzNDgsImV4cCI6MjEwNTU1MjM0OH0.rPNYvExcIUzm5WmiMq-EjsY2pZPjZ5kMSjRMoNrCGD8
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVjY2hrY3N1Yml6dXdidm9zdHlsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4OTk3NjM0OCwiZXhwIjoyMTA1NTUyMzQ4fQ.nP6HEabC64yB6XYpSmyT43HmLcQNuMBW19wmD7fTz-I

# ESP32 Receiver/Gateway Serial Connection
# USB connection is ONLY to the RECEIVER ESP32 (#2).
# The SENSOR_NODE ESP32 (#1) communicates with the receiver wirelessly via ESP-NOW.
SERIAL_PORT=COM5
SERIAL_BAUD_RATE=115200
SERIAL_AUTO_RECONNECT=true
SERIAL_RECONNECT_INTERVAL_MS=5000

# Two-node ESP32 topology identifiers
GATEWAY_ID=ESP32_RX_01
SENSOR_NODE_ID=ESP32_SENSOR_01

# Weather API (Bailadila Deposit 14, Kirandul Mine coordinates)
MINE_LATITUDE=18.6312
MINE_LONGITUDE=81.2485
WEATHER_UPDATE_INTERVAL_MS=600000
WEATHER_CACHE_TTL_MS=900000

# Optional External Python/FastAPI ML Service
ML_ENABLED=true
ML_SERVICE_URL=http://localhost:8000/predict
ML_TIMEOUT_MS=800

# Defaults
DEFAULT_SITE_ID=site-kirandul-01
DEFAULT_VEHICLE_ID=veh-d104
