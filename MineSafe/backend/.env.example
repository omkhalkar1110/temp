# MineSafe Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Operational Mode: 'SIMULATION' or 'HARDWARE'
OPERATION_MODE=SIMULATION
SIMULATION_ENABLED=true
HARDWARE_ENABLED=true

# Single Cloud Database (Supabase PostgreSQL)
# Get these from: Supabase Dashboard > Project Settings > API
# NOTE: This is a Vite + Node.js project — do NOT use @supabase/ssr or NEXT_PUBLIC_* keys.
# The frontend never connects to Supabase directly; it talks to this Node.js backend only.
# The backend uses the service_role key (full access, server-only) or anon key.
#
# SUPABASE_PUBLISHABLE_KEY is Supabase's new dashboard label for the anon key.
# Use SUPABASE_ANON_KEY here (same JWT, just labeled differently in the UI).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key         # also shown as "publishable key" in dashboard
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ESP32 Receiver/Gateway Serial Connection
# ─────────────────────────────────────────────────────────────────────────────
# The backend connects ONLY to ESP32 #2 (RECEIVER/GATEWAY) over USB Serial.
# ESP32 #1 (SENSOR_NODE) is NEVER connected to the laptop.
# It communicates with the receiver wirelessly via ESP-NOW.
#
# Data path:
#   ESP32 SENSOR_NODE (MPU6500 + HC-SR04)
#       ↓  ESP-NOW (wireless)
#   ESP32 RECEIVER/GATEWAY
#       ↓  USB Serial (Windows COMx)
#   Node.js backend (hardware.js)
#
# Leave SERIAL_PORT empty to auto-detect the receiver's COM port.
# Auto-detection excludes Bluetooth virtual COM ports.
SERIAL_PORT=
SERIAL_BAUD_RATE=115200
SERIAL_AUTO_RECONNECT=true
SERIAL_RECONNECT_INTERVAL_MS=5000

# Logical identifiers for the two-node ESP32 topology
GATEWAY_ID=ESP32_RX_01        # ESP32 #2 — USB-connected receiver/gateway
SENSOR_NODE_ID=ESP32_SENSOR_01 # ESP32 #1 — wireless sensor node (MPU6500 + HC-SR04)

# Weather API (Bailadila Deposit 14, Kirandul Mine coordinates)
MINE_LATITUDE=18.6312
MINE_LONGITUDE=81.2485
WEATHER_UPDATE_INTERVAL_MS=600000
WEATHER_CACHE_TTL_MS=900000

# Optional External Python/FastAPI ML Service
ML_ENABLED=false
ML_SERVICE_URL=http://localhost:8000/predict
ML_TIMEOUT_MS=800

# Defaults
DEFAULT_SITE_ID=site-kirandul-01
DEFAULT_VEHICLE_ID=veh-d104
