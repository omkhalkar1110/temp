# MineSafe Frontend Environment — Local Development
# Generated for local end-to-end demo (simulation mode)

# Backend REST API and Socket.IO server
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Demo / Auth mode (true = no real Firebase required)
VITE_DEMO_MODE=true

# Google Maps (optional — dashboard map works without this in fallback mode)
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Auth (optional — email/password dev bypass is active without these)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=